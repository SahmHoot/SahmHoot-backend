# 서버 /etc/systemd/system/sahmhoot.service 사본(2026-11-18 `systemctl cat sahmhoot`로 확인).
# 서버 파일을 바꾸면 이 파일도 같이 고친다. 비밀값은 Environment= 대신 EnvironmentFile로만 받는다.
[Unit]
Description=Sahmhoot Spring Boot
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=sahmhoot
WorkingDirectory=/opt/sahmhoot
EnvironmentFile=/etc/sahmhoot.env
ExecStart=/usr/bin/java -jar /opt/sahmhoot/app.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
