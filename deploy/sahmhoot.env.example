# 서버 /etc/sahmhoot.env 의 키 목록. 값은 서버에만 둔다(root:root, 600). 이 파일에는 값을 적지 않는다.
# 실제 값은 노션 비공개 페이지에 기록한다. 바꾼 뒤에는 sudo systemctl restart sahmhoot

# 필수. 하나라도 비면 deploy/deploy.sh가 배포를 멈춘다.
SPRING_PROFILES_ACTIVE=prod
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
# 쉼표로 구분. 예: https://sahmhoot.com,https://www.sahmhoot.com
CORS_ALLOWED_ORIGINS=
# 학생 참여 링크·QR 주소. 예: https://sahmhoot.com
APP_ROOM_JOIN_BASE_URL=
# 인증 메일 보내는 주소(#21). 예: no-reply@sahmhoot.com. 없으면 앱이 기동하지 않는다.
MAIL_FROM=

# 선택. 비우면 기본값 jdbc:mysql://localhost:3306/sahmhoot 를 쓴다.
#DB_URL=

# 선택(#21). 비우면 같은 VM의 Postfix(127.0.0.1:25)로 보낸다. 외부 릴레이는 Postfix가 맡는다.
#MAIL_HOST=

# 선택(#98). 쉼표로 구분한 가입 허용 도메인. 비우면 제한 없음.
#ALLOWED_EMAIL_DOMAINS=

# 선택(#121). 운영 VM의 서비스 계정과 메타데이터 ADC를 사용한다.
# 배포 또는 별도 활성화 승인 전에는 false로 유지한다.
APP_QUESTION_IMAGES_ENABLED=false
#APP_QUESTION_IMAGES_GCS_PROJECT_ID=
#APP_QUESTION_IMAGES_GCS_BUCKET=
