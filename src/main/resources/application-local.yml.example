spring:
  datasource:
    password: ${DB_PASSWORD}
  mail:
    # SSH 터널: 이 PC의 2525 → GCP VM의 127.0.0.1:25
    host: ${MAIL_HOST:127.0.0.1}
    port: ${MAIL_PORT:2525}

app:
  seed:
    enabled: true
  mail:
    from: ${MAIL_FROM:no-reply@sahmhoot.com}
  # 선택: JWT_SECRET을 지정하면 로컬 재시작 후에도 기존 토큰을 유지한다.
  # jwt:
  #   secret: ${JWT_SECRET}
